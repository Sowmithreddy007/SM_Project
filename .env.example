# Copy this file to .env and replace every placeholder before deploying.
# Never commit the real .env file.

# --- PostgreSQL -------------------------------------------------------------
# Use a long random value, for example: openssl rand -base64 32
DB_PASSWORD=replace-with-a-long-random-password

# --- Application ------------------------------------------------------------
APP_BASE_URL=https://social.stpetershyd.com
APP_REVIEWER_EMAIL=president@stpetershyd.com
APP_TIMEZONE=Asia/Kolkata
APP_BACKUP_RETENTION_DAYS=30
TZ=Asia/Kolkata

# --- First Super Admin ------------------------------------------------------
# Created only when the database has no users. The President can sign in with
# this account and should change the password after the first login.
APP_BOOTSTRAP_ADMIN_EMAIL=president@stpetershyd.com
APP_BOOTSTRAP_ADMIN_NAME=SPECANCIENS President
APP_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-temporary-password
